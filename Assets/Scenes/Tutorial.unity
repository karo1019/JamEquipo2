  dialogueText: {fileID: 0}
  dialogueLines:
  - "\xBFTengo redenci\xF3n? He hecho cosas horribles para sobrevivir y cada maldita
    noche esos recuerdos me persiguen, mi cabeza no me da tregua, mis pecados suben
    por mis hombros y me oprimen el pecho al punto de que ya no puedo respirar, estoy
    muriendo por dentro \xBFPor qu\xE9 no morir por fuera tambi\xE9n?\r\n\r\n"
  textSpeed: 0.1
  audioSource: {fileID: 709709251}
